# Copy to  api/.env  and adjust. All keys are optional; defaults suit local dev.

# Dev default is a SQLite file at api/var/dev.db. For Postgres:
# OPLAPI_DATABASE_URL=postgresql+psycopg://oplpops:oplpops@localhost:5432/oplpops

# Where blobs (images, VMCs, jars, tool binaries) are stored on disk.
# OPLAPI_BLOB_ROOT=./var/blobs

# App-update source (see app/github.py). Only needed to raise GitHub's
# unauthenticated 60 req/hr limit - no special token scope required.
# OPLAPI_GITHUB_TOKEN=ghp_...

# Off by default. Only turn on if this API is reachable beyond localhost, and
# size it generously - a batch download in the desktop app can easily fire a
# few thousand requests in a few minutes.
# OPLAPI_RATE_LIMIT_PER_MINUTE=3000

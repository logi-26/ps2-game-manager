# Copy to  api/.env  and adjust. All keys are optional; defaults suit local dev.

# Dev default is a SQLite file at api/var/dev.db. For Postgres:
# OPLAPI_DATABASE_URL=postgresql+psycopg://oplpops:oplpops@localhost:5432/oplpops

# Where blobs (images, VMCs, jars, tool binaries) are stored on disk.
# OPLAPI_BLOB_ROOT=./var/blobs

# When set, POST endpoints require this value in an X-API-Key header.
# OPLAPI_WRITE_API_KEY=change-me

# OPLAPI_MAX_UPLOAD_BYTES=33554432

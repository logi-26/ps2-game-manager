<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefHeight="652.0" prefWidth="830.0" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ps2gm.game.manager.fx.GameImageController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="gameNameField" editable="false" maxWidth="-Infinity" prefHeight="23.0" prefWidth="480.0" HBox.hgrow="ALWAYS" />
        <TextField fx:id="gameNumberField" alignment="CENTER" editable="false" prefWidth="90.0">
         <HBox.margin>
            <Insets left="10.0" />
         </HBox.margin></TextField>
        <Button fx:id="prevButton" onAction="#onPrev" prefWidth="60.0" text="←">
         <HBox.margin>
            <Insets left="70.0" />
         </HBox.margin></Button>
        <Button fx:id="nextButton" onAction="#onNext" prefWidth="60.0" text="→">
         <HBox.margin>
            <Insets left="10.0" />
         </HBox.margin></Button>
    </HBox>

    <!-- Free-placement canvas. Every pane carries its own layoutX/layoutY AND a
         hard size (min == pref == max on both axes). The image inside each pane
         binds its fit box to the pane's own StackPane, so loading art can never
         resize a pane - what Scene Builder shows is exactly what renders. Drag
         panes freely; resize a pane by editing its prefWidth/prefHeight (keep
         the matching min*/max* equal).

         The File / Auto / Delete controls are Ikonli (Feather) font icons on
         "button-icon flat" buttons - AtlantaFX styles .ikonli-font-icon per
         theme, so the glyphs recolour with the theme automatically. -->
    <AnchorPane maxWidth="-Infinity" prefHeight="599.0" prefWidth="810.0" VBox.vgrow="NEVER">

      <TitledPane collapsible="false" layoutX="0.0" layoutY="0.0" maxHeight="282.0" maxWidth="155.0" minHeight="282.0" minWidth="155.0" prefHeight="282.0" prefWidth="155.0" text="Front Cover">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <StackPane fx:id="covBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                  <ImageView fx:id="covView" fitHeight="${covBox.height}" fitWidth="${covBox.width}" preserveRatio="true" />
               </StackPane>
               <HBox alignment="CENTER" spacing="6.0">
                  <Button onAction="#onFile" styleClass="button-icon,flat" userData="_COV"><graphic><FontIcon iconLiteral="fth-image" /></graphic><tooltip><Tooltip text="Choose an image file" /></tooltip></Button>
                  <Button onAction="#onAuto" styleClass="button-icon,flat" userData="_COV"><graphic><FontIcon iconLiteral="fth-download-cloud" /></graphic><tooltip><Tooltip text="Download from the art server" /></tooltip></Button>
                  <Button onAction="#onDelete" styleClass="button-icon,flat" userData="_COV"><graphic><FontIcon iconLiteral="fth-trash-2" /></graphic><tooltip><Tooltip text="Delete this artwork" /></tooltip></Button>
               </HBox>
            </VBox>
         </content>
      </TitledPane>

      <TitledPane fx:id="spineTitledPane" collapsible="false" layoutX="180.0" layoutY="0.0" maxHeight="282.0" maxWidth="120.0" minHeight="282.0" minWidth="120.0" prefHeight="282.0" prefWidth="120.0" text="Spine">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <StackPane fx:id="spineBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                  <ImageView fx:id="spineView" fitHeight="${spineBox.height}" fitWidth="${spineBox.width}" preserveRatio="true" />
               </StackPane>
               <HBox alignment="CENTER" spacing="4.0">
                  <Button onAction="#onFile" styleClass="button-icon,flat" userData="_LAB"><graphic><FontIcon iconLiteral="fth-image" /></graphic><tooltip><Tooltip text="Choose an image file" /></tooltip></Button>
                  <Button onAction="#onAuto" styleClass="button-icon,flat" userData="_LAB"><graphic><FontIcon iconLiteral="fth-download-cloud" /></graphic><tooltip><Tooltip text="Download from the art server" /></tooltip></Button>
                  <Button onAction="#onDelete" styleClass="button-icon,flat" userData="_LAB"><graphic><FontIcon iconLiteral="fth-trash-2" /></graphic><tooltip><Tooltip text="Delete this artwork" /></tooltip></Button>
               </HBox>
            </VBox>
         </content>
      </TitledPane>

      <TitledPane collapsible="false" layoutX="325.0" layoutY="0.0" maxHeight="282.0" maxWidth="155.0" minHeight="282.0" minWidth="155.0" prefHeight="282.0" prefWidth="155.0" text="Rear Cover">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <StackPane fx:id="cov2Box" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                  <ImageView fx:id="cov2View" fitHeight="${cov2Box.height}" fitWidth="${cov2Box.width}" preserveRatio="true" />
               </StackPane>
               <HBox alignment="CENTER" spacing="6.0">
                  <Button onAction="#onFile" styleClass="button-icon,flat" userData="_COV2"><graphic><FontIcon iconLiteral="fth-image" /></graphic><tooltip><Tooltip text="Choose an image file" /></tooltip></Button>
                  <Button onAction="#onAuto" styleClass="button-icon,flat" userData="_COV2"><graphic><FontIcon iconLiteral="fth-download-cloud" /></graphic><tooltip><Tooltip text="Download from the art server" /></tooltip></Button>
                  <Button onAction="#onDelete" styleClass="button-icon,flat" userData="_COV2"><graphic><FontIcon iconLiteral="fth-trash-2" /></graphic><tooltip><Tooltip text="Delete this artwork" /></tooltip></Button>
               </HBox>
            </VBox>
         </content>
      </TitledPane>

      <TitledPane collapsible="false" layoutX="500.0" layoutY="0.0" maxHeight="150.0" maxWidth="150.0" minHeight="150.0" minWidth="150.0" prefHeight="150.0" prefWidth="150.0" text="Disc">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <StackPane fx:id="discBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                  <ImageView fx:id="discView" fitHeight="${discBox.height}" fitWidth="${discBox.width}" preserveRatio="true" />
               </StackPane>
               <HBox alignment="CENTER" spacing="6.0">
                  <Button onAction="#onFile" styleClass="button-icon,flat" userData="_ICO"><graphic><FontIcon iconLiteral="fth-image" /></graphic><tooltip><Tooltip text="Choose an image file" /></tooltip></Button>
                  <Button onAction="#onAuto" styleClass="button-icon,flat" userData="_ICO"><graphic><FontIcon iconLiteral="fth-download-cloud" /></graphic><tooltip><Tooltip text="Download from the art server" /></tooltip></Button>
                  <Button onAction="#onDelete" styleClass="button-icon,flat" userData="_ICO"><graphic><FontIcon iconLiteral="fth-trash-2" /></graphic><tooltip><Tooltip text="Delete this artwork" /></tooltip></Button>
               </HBox>
            </VBox>
         </content>
      </TitledPane>

      <TitledPane collapsible="false" layoutX="500.0" layoutY="170.0" maxHeight="160.0" maxWidth="300.0" minHeight="160.0" minWidth="300.0" prefHeight="160.0" prefWidth="300.0" text="Logo">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <StackPane fx:id="logoBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                  <ImageView fx:id="logoView" fitHeight="${logoBox.height}" fitWidth="${logoBox.width}" preserveRatio="true" />
               </StackPane>
               <HBox alignment="CENTER" spacing="6.0">
                  <Button onAction="#onFile" styleClass="button-icon,flat" userData="_LGO"><graphic><FontIcon iconLiteral="fth-image" /></graphic><tooltip><Tooltip text="Choose an image file" /></tooltip></Button>
                  <Button onAction="#onAuto" styleClass="button-icon,flat" userData="_LGO"><graphic><FontIcon iconLiteral="fth-download-cloud" /></graphic><tooltip><Tooltip text="Download from the art server" /></tooltip></Button>
                  <Button onAction="#onDelete" styleClass="button-icon,flat" userData="_LGO"><graphic><FontIcon iconLiteral="fth-trash-2" /></graphic><tooltip><Tooltip text="Delete this artwork" /></tooltip></Button>
               </HBox>
            </VBox>
         </content>
      </TitledPane>

      <TitledPane collapsible="false" layoutX="500.0" layoutY="350.0" maxHeight="243.0" maxWidth="300.0" minHeight="243.0" minWidth="300.0" prefHeight="243.0" prefWidth="300.0" text="Background">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <StackPane fx:id="bgBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                  <ImageView fx:id="bgView" fitHeight="${bgBox.height}" fitWidth="${bgBox.width}" preserveRatio="true" />
               </StackPane>
               <HBox alignment="CENTER" spacing="6.0">
                  <Button onAction="#onFile" styleClass="button-icon,flat" userData="_BG"><graphic><FontIcon iconLiteral="fth-image" /></graphic><tooltip><Tooltip text="Choose an image file" /></tooltip></Button>
                  <Button onAction="#onAuto" styleClass="button-icon,flat" userData="_BG"><graphic><FontIcon iconLiteral="fth-download-cloud" /></graphic><tooltip><Tooltip text="Download from the art server" /></tooltip></Button>
                  <Button onAction="#onDelete" styleClass="button-icon,flat" userData="_BG"><graphic><FontIcon iconLiteral="fth-trash-2" /></graphic><tooltip><Tooltip text="Delete this artwork" /></tooltip></Button>
               </HBox>
            </VBox>
         </content>
      </TitledPane>

      <TitledPane collapsible="false" layoutX="0.0" layoutY="350.0" maxHeight="243.0" maxWidth="230.0" minHeight="243.0" minWidth="230.0" prefHeight="243.0" prefWidth="230.0" text="Screenshot 1">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <StackPane fx:id="scr1Box" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                  <ImageView fx:id="scr1View" fitHeight="${scr1Box.height}" fitWidth="${scr1Box.width}" preserveRatio="true" />
               </StackPane>
               <HBox alignment="CENTER" spacing="6.0">
                  <Button onAction="#onFile" styleClass="button-icon,flat" userData="_SCR"><graphic><FontIcon iconLiteral="fth-image" /></graphic><tooltip><Tooltip text="Choose an image file" /></tooltip></Button>
                  <Button onAction="#onAuto" styleClass="button-icon,flat" userData="_SCR"><graphic><FontIcon iconLiteral="fth-download-cloud" /></graphic><tooltip><Tooltip text="Download from the art server" /></tooltip></Button>
                  <Button onAction="#onDelete" styleClass="button-icon,flat" userData="_SCR"><graphic><FontIcon iconLiteral="fth-trash-2" /></graphic><tooltip><Tooltip text="Delete this artwork" /></tooltip></Button>
               </HBox>
            </VBox>
         </content>
      </TitledPane>

      <TitledPane collapsible="false" layoutX="250.0" layoutY="350.0" maxHeight="243.0" maxWidth="230.0" minHeight="243.0" minWidth="230.0" prefHeight="243.0" prefWidth="230.0" text="Screenshot 2">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <StackPane fx:id="scr2Box" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
                  <ImageView fx:id="scr2View" fitHeight="${scr2Box.height}" fitWidth="${scr2Box.width}" preserveRatio="true" />
               </StackPane>
               <HBox alignment="CENTER" spacing="6.0">
                  <Button onAction="#onFile" styleClass="button-icon,flat" userData="_SCR2"><graphic><FontIcon iconLiteral="fth-image" /></graphic><tooltip><Tooltip text="Choose an image file" /></tooltip></Button>
                  <Button onAction="#onAuto" styleClass="button-icon,flat" userData="_SCR2"><graphic><FontIcon iconLiteral="fth-download-cloud" /></graphic><tooltip><Tooltip text="Download from the art server" /></tooltip></Button>
                  <Button onAction="#onDelete" styleClass="button-icon,flat" userData="_SCR2"><graphic><FontIcon iconLiteral="fth-trash-2" /></graphic><tooltip><Tooltip text="Delete this artwork" /></tooltip></Button>
               </HBox>
            </VBox>
         </content>
      </TitledPane>

   </AnchorPane>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="652.0" prefWidth="813.0" spacing="10.0" style="-fx-font-family: 'Segoe UI', 'Ubuntu', sans-serif; -fx-font-size: 12px;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ps2gm.game.manager.fx.GameImageController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="gameNameField" editable="false" maxWidth="-Infinity" prefHeight="23.0" prefWidth="600.0" HBox.hgrow="ALWAYS" />
        <TextField fx:id="gameNumberField" alignment="CENTER" editable="false" prefWidth="90.0" />
        <Button fx:id="nextButton" onAction="#onNext" prefWidth="40.0" text="►" />
        <Button fx:id="prevButton" onAction="#onPrev" prefWidth="40.0" text="◄" />
    </HBox>

    <!-- Free-placement canvas: each pane carries its own layoutX/layoutY so the
         layout can be dragged around in Scene Builder. Nothing here is anchored. -->
    <AnchorPane maxWidth="-Infinity" prefHeight="599.0" prefWidth="793.0" VBox.vgrow="NEVER">
      <TitledPane collapsible="false" layoutX="500.0" layoutY="350.0" prefHeight="243.0" prefWidth="300.0" text="Background">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <StackPane minHeight="170.0" minWidth="283.0" prefHeight="170.0" prefWidth="283.0">
                     <children>
                        <ImageView fx:id="bgView" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <HBox spacing="4.0">
                     <children>
                        <Button onAction="#onFile" text="File" userData="_BG" />
                        <Button onAction="#onAuto" text="Auto" userData="_BG" />
                        <Button onAction="#onDelete" text="Del" userData="_BG" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </TitledPane>
      <TitledPane collapsible="false" layoutY="350.0" minWidth="-Infinity" prefHeight="243.0" prefWidth="230.0" text="Screenshot 1">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <StackPane minHeight="170.0" minWidth="210.0" prefHeight="170.0" prefWidth="210.0">
                     <children>
                        <ImageView fx:id="scr1View" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <HBox spacing="4.0">
                     <children>
                        <Button onAction="#onFile" text="File" userData="_SCR" />
                        <Button onAction="#onAuto" text="Auto" userData="_SCR" />
                        <Button onAction="#onDelete" text="Del" userData="_SCR" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </TitledPane>
      <TitledPane collapsible="false" layoutX="250.0" layoutY="350.0" prefHeight="243.0" prefWidth="230.0" text="Screenshot 2">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <StackPane minHeight="170.0" minWidth="210.0" prefHeight="170.0" prefWidth="210.0">
                     <children>
                        <ImageView fx:id="scr2View" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <HBox spacing="4.0">
                     <children>
                        <Button onAction="#onFile" text="File" userData="_SCR2" />
                        <Button onAction="#onAuto" text="Auto" userData="_SCR2" />
                        <Button onAction="#onDelete" text="Del" userData="_SCR2" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </TitledPane>
      <TitledPane collapsible="false" layoutX="325.0" prefWidth="155.0" text="Rear Cover">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <StackPane minHeight="160.0">
                     <children>
                        <ImageView fx:id="cov2View" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <HBox spacing="4.0">
                     <children>
                        <Button onAction="#onFile" text="File" userData="_COV2" />
                        <Button onAction="#onAuto" text="Auto" userData="_COV2" />
                        <Button onAction="#onDelete" text="Del" userData="_COV2" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </TitledPane>
      <TitledPane collapsible="false" layoutX="500.0" text="Disc">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <StackPane minHeight="80.0">
                     <children>
                        <ImageView fx:id="discView" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <HBox spacing="4.0">
                     <children>
                        <Button onAction="#onFile" text="File" userData="_ICO" />
                        <Button onAction="#onAuto" text="Auto" userData="_ICO" />
                        <Button onAction="#onDelete" text="Del" userData="_ICO" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </TitledPane>
      <TitledPane collapsible="false" layoutX="500.0" layoutY="170.0" prefHeight="160.0" prefWidth="300.0" text="Logo">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <StackPane minHeight="80.0">
                     <children>
                        <ImageView fx:id="logoView" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <HBox spacing="4.0">
                     <children>
                        <Button onAction="#onFile" text="File" userData="_LGO" />
                        <Button onAction="#onAuto" text="Auto" userData="_LGO" />
                        <Button onAction="#onDelete" text="Del" userData="_LGO" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </TitledPane>
      <TitledPane fx:id="spineTitledPane" collapsible="false" layoutX="180.0" minWidth="-Infinity" prefHeight="233.0" prefWidth="120.0" text="Spine">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <StackPane minHeight="0.0" minWidth="34.0" VBox.vgrow="ALWAYS">
                     <children>
                        <ImageView fx:id="spineView" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <VBox alignment="CENTER" spacing="4.0">
                     <children>
                        <Button maxWidth="Infinity" onAction="#onFile" prefHeight="23.0" prefWidth="66.0" text="File" userData="_LAB" />
                        <Button maxWidth="Infinity" onAction="#onAuto" text="Auto" userData="_LAB" />
                        <Button maxWidth="Infinity" onAction="#onDelete" text="Del" userData="_LAB" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </TitledPane>
      <TitledPane fx:id="frontCoverTitledPane" collapsible="false" prefWidth="155.0" text="Front Cover">
         <content>
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <StackPane minHeight="160.0">
                     <children>
                        <ImageView fx:id="covView" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <HBox spacing="4.0">
                     <children>
                        <Button onAction="#onFile" text="File" userData="_COV" />
                        <Button onAction="#onAuto" text="Auto" userData="_COV" />
                        <Button onAction="#onDelete" text="Del" userData="_COV" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </TitledPane>
    </AnchorPane>
</VBox>

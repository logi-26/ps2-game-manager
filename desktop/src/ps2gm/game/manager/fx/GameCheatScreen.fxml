<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ps2gm.game.manager.fx.GameCheatController"
      spacing="10.0" prefWidth="900.0" prefHeight="560.0"
      style="-fx-font-family: 'Segoe UI', 'Ubuntu', sans-serif; -fx-font-size: 12px;">
    <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/></padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="gameNumberField" editable="false" alignment="CENTER" prefWidth="90.0"/>
        <TextField fx:id="gameNameField" editable="false" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="prevButton" text="&lt;&lt;" prefWidth="55.0" onAction="#onPrev"/>
        <Button fx:id="nextButton" text="&gt;&gt;" prefWidth="55.0" onAction="#onNext"/>
    </HBox>

    <HBox spacing="10.0" VBox.vgrow="ALWAYS">
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <TitledPane text="Cheat File" collapsible="false" VBox.vgrow="ALWAYS">
                <VBox spacing="8.0">
                    <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
                    <TextArea fx:id="cheatContentArea" VBox.vgrow="ALWAYS" wrapText="false"
                              style="-fx-font-family: 'Consolas', 'DejaVu Sans Mono', monospace;"/>
                    <HBox spacing="20.0" alignment="CENTER">
                        <Button fx:id="saveButton" text="Save" prefWidth="85.0" onAction="#onSave"/>
                        <Button fx:id="undoButton" text="Undo" prefWidth="85.0" onAction="#onUndo"/>
                        <Button fx:id="deleteButton" text="Delete" prefWidth="85.0" onAction="#onDelete"/>
                    </HBox>
                </VBox>
            </TitledPane>
        </VBox>

        <VBox alignment="CENTER">
            <Button fx:id="addButton" text="&#171; Add" prefWidth="70.0" onAction="#onAddSelected"/>
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <TitledPane text="Cheats From Server" collapsible="false" VBox.vgrow="ALWAYS">
                <VBox>
                    <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
                    <ListView fx:id="serverCheatList" VBox.vgrow="ALWAYS"/>
                </VBox>
            </TitledPane>
        </VBox>
    </HBox>
</VBox>

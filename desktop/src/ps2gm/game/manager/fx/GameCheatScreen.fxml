<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="501.0" prefWidth="900.0" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ps2gm.game.manager.fx.GameCheatController">
    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="gameNumberField" alignment="CENTER" editable="false" prefWidth="90.0" />
        <TextField fx:id="gameNameField" editable="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
        <Button fx:id="prevButton" onAction="#onPrev" prefWidth="55.0" text="&lt;&lt;" />
        <Button fx:id="nextButton" onAction="#onNext" prefWidth="55.0" text="&gt;&gt;" />
    </HBox>

    <HBox spacing="10.0" VBox.vgrow="ALWAYS">
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <TitledPane collapsible="false" text="Cheat File" VBox.vgrow="ALWAYS">
                <VBox prefHeight="413.0" prefWidth="362.0" spacing="8.0">
                    <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>
                    <TextArea fx:id="cheatContentArea" style="-fx-font-family: 'Consolas', 'DejaVu Sans Mono', monospace;" wrapText="false" VBox.vgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="20.0">
                        <Button fx:id="saveButton" onAction="#onSave" prefWidth="85.0" styleClass="accent" text="Save" />
                        <Button fx:id="undoButton" onAction="#onUndo" prefWidth="85.0" text="Undo" />
                        <Button fx:id="deleteButton" onAction="#onDelete" prefWidth="85.0" text="Delete" />
                    </HBox>
                </VBox>
            </TitledPane>
        </VBox>

        <VBox alignment="CENTER">
            <Button fx:id="addButton" onAction="#onAddSelected" prefWidth="70.0" styleClass="accent" text="←" />
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <TitledPane collapsible="false" text="Cheats From Server" VBox.vgrow="ALWAYS">
                <VBox>
                    <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>
                    <ListView fx:id="serverCheatList" VBox.vgrow="ALWAYS" />
                </VBox>
            </TitledPane>
        </VBox>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ps2gm.game.manager.fx.ChangelogController"
      prefWidth="700.0" prefHeight="420.0"
      style="-fx-font-family: 'Segoe UI', 'Ubuntu', sans-serif;">
    <padding>
        <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
    </padding>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <TextFlow fx:id="changelogFlow">
            <padding>
                <Insets top="8.0" right="12.0" bottom="8.0" left="12.0"/>
            </padding>
        </TextFlow>
    </ScrollPane>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ps2gm.game.manager.fx.SetModeController"
      spacing="10.0" prefWidth="600.0"
      style="-fx-font-family: 'Segoe UI', 'Ubuntu', sans-serif; -fx-font-size: 12px;">
    <padding><Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/></padding>

    <TitledPane text="SMB Mode" collapsible="false">
        <VBox spacing="8.0">
            <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
            <RadioButton fx:id="smbRadio" text="OPL folder is on this PC.">
                <toggleGroup><ToggleGroup fx:id="modeGroup"/></toggleGroup>
            </RadioButton>
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label fx:id="smbPathLabel" text="Path:" minWidth="45.0"/>
                <TextField fx:id="smbPathField" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                <Button fx:id="smbBrowseButton" text="Browse" onAction="#onBrowseSmb" prefWidth="90.0"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="HDD Mode" collapsible="false">
        <VBox spacing="8.0">
            <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
            <RadioButton fx:id="hddRadio" text="OPL folder is on internal PS2 HDD." toggleGroup="$modeGroup"/>
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label fx:id="ipLabel" text="PS2 IP:" minWidth="45.0"/>
                <TextField fx:id="ipField" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                <Button fx:id="connectButton" text="Connect" onAction="#onConnect" prefWidth="90.0"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="USB Mode" collapsible="false">
        <VBox spacing="8.0">
            <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
            <RadioButton fx:id="usbRadio" text="OPL folder is on USB drive." toggleGroup="$modeGroup"/>
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label fx:id="usbPathLabel" text="Path:" minWidth="45.0"/>
                <TextField fx:id="usbPathField" editable="false" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                <Button fx:id="usbBrowseButton" text="Browse" onAction="#onBrowseUsb" prefWidth="90.0"/>
            </HBox>
        </VBox>
    </TitledPane>

    <HBox spacing="36.0" alignment="CENTER_RIGHT">
        <Button fx:id="saveButton" text="Save" onAction="#onSave" prefWidth="85.0"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" prefWidth="85.0"/>
    </HBox>
</VBox>

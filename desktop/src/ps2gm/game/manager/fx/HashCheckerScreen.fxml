<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ps2gm.game.manager.fx.HashCheckerController"
      spacing="10.0" prefWidth="460.0"
      style="-fx-font-family: 'Segoe UI', 'Ubuntu', sans-serif; -fx-font-size: 12px;">
    <padding>
        <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
    </padding>

    <TitledPane text="Selected Game" collapsible="false">
        <VBox spacing="8.0">
            <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
            <TextField fx:id="gameNameField" editable="false"/>
            <HBox spacing="10.0">
                <TextField fx:id="gameIdField" editable="false" alignment="CENTER" prefWidth="120.0"/>
                <Label HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="startButton" text="Start" prefWidth="80.0" onAction="#onStart"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Progress" collapsible="false">
        <GridPane hgap="12.0" vgap="10.0">
            <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
            <columnConstraints>
                <ColumnConstraints minWidth="70.0"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="MD5:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="md5Field" editable="false" alignment="CENTER" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Progress:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ProgressBar fx:id="progressBar" progress="0.0" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>
    </TitledPane>
</VBox>

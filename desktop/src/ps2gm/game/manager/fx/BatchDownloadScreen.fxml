                <CheckBox fx:id="rearCoverCheck" selected="true" text="Rear Covers" />
                <CheckBox fx:id="spineCheck" selected="true" text="Spine" />
                <CheckBox fx:id="logoCheck" selected="true" text="Logo" />
                <CheckBox fx:id="discCheck" selected="true" text="Disc Images" />
                <CheckBox fx:id="screenshotCheck" selected="true" text="Screenshots" />
                <CheckBox fx:id="backgroundCheck" selected="true" text="Background Images" />

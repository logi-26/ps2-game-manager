<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ps2gm.game.manager.fx.GameImageSelectorController"
      spacing="10.0"
      style="-fx-font-family: 'Segoe UI', 'Ubuntu', sans-serif; -fx-font-size: 12px;">
    <padding>
        <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
    </padding>

    <TitledPane fx:id="titledPane" text="Image" collapsible="false">
        <StackPane minWidth="400.0" minHeight="300.0">
            <padding><Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/></padding>
            <ImageView fx:id="imageView" preserveRatio="true"/>
        </StackPane>
    </TitledPane>

    <HBox spacing="12.0" alignment="CENTER">
        <Button fx:id="prevButton" text="◄" prefWidth="44.0" onAction="#onPrev"/>
        <TextField fx:id="numberField" editable="false" alignment="CENTER" prefWidth="90.0"/>
        <Button fx:id="nextButton" text="►" prefWidth="44.0" onAction="#onNext"/>
        <Button fx:id="saveButton" text="Use this image" onAction="#onSave"/>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ps2gm.game.manager.fx.GameLongNameController"
      spacing="14.0" prefWidth="460.0" prefHeight="360.0">
    <padding>
        <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
    </padding>

    <TitledPane text="Rename Game" collapsible="false">
        <VBox spacing="10.0">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="6.0"/></padding>
            <GridPane hgap="12.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="70.0" halignment="RIGHT"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Old Title:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="oldTitleField" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="New Title:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="newTitleField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>
            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="renameButton" text="Rename" prefWidth="90.0" onAction="#onRename"/>
            </HBox>
        </VBox>
    </TitledPane>

    <TitledPane text="Game List" collapsible="false" VBox.vgrow="ALWAYS">
        <ListView fx:id="gameListView"/>
    </TitledPane>
</VBox>

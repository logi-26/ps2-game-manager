# ---------------------------------------------------------------------------
# ps2-game-manager - monorepo ignore rules
#   desktop/  Java Swing app        api/  Python HTTP API + database
# ---------------------------------------------------------------------------

# --- Java / NetBeans build output ---
**/build/
**/dist/
**/nbproject/private/
*.class
build-local/
*-local.jar
hs_err_pid*.log
*.hprof

# --- app-generated runtime churn (see desktop/build.ps1) ---
desktop/ps2gm-settings
desktop/settings.xml
desktop/READ ME.txt
desktop/start-linux.sh
desktop/start-windows.bat
desktop/invalidGameList*
desktop/ul-backup*
desktop/hdd_usb

# --- Python (Part 2) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- api/ runtime state (dev db + blob store) ---
api/var/
*.db
api/.env

# --- local data corpora (kept outside git - large binaries) ---
# The desktop OPL test drive and the server's file corpus live next to the
# repo, not in it. Guard against them being added by accident.
/program_test_folder/
/Server Content/
/server-content/
*.iso
*.ISO
*.VCD
*.vcd

# --- editor / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
